pipeline {
    agent any

tools {
    maven 'maven3'
    jdk 'jdk17'
    nodejs 'nodejs23'
}

environment{
    SCANNER_HOME = tool 'sonarqube-scanner'
}

    stages {
        stage('Git Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/yukesh-v/Boardgame.git'
            }
        }
        stage('Git Leaks') {
            steps {
                sh 'gitleaks detect --source . --report-path leaks.sarif --exit-code 1'
            }
        }
        stage('Compilation') {
            steps {
                sh 'mvn compile'
            }
        }
        stage('Unit Test') {
            steps {
                sh 'mvn test'
            }
        }
        stage('Trivy fs scan') {
            steps {
                sh 'trivy fs --format table -o fs-scan.html .'
            }
        }
        stage('SonarQube analysis') {
            steps {
                withSonarQubeEnv('sonar') {
                  sh '''$SCANNER_HOME/bin/sonar-scanner -Dsonar.projectKey=Boardgame -Dsonar.projectName=Boardgame\
                  -Dsonar.java.binaries=. '''
              }
            }
        }
        stage('Maven Build') {
            steps {
                sh 'mvn package'
            }
        }
        stage('Deploy To Nexus') {
            steps {
                withMaven(globalMavenSettingsConfig: 'Maven-settings', jdk: 'jdk17', maven: 'maven3', traceability: true) {
                sh 'mvn deploy'
              }
            }
        }
         stage('Docker Build & Tag') {
            steps {
              script {
                withDockerRegistry(credentialsId: 'docker-cred') {
                  sh 'export DOCKER_BUILDKIT=1'
                  sh 'docker build -t yukesh24/boardgame:latest .'
                }
              }
            }
        }
         stage('Trivy Image Scan') {
            steps {
                sh 'trivy image --format table -o image-scan-report.html yukesh24/boardgame:latest '
            }
        }
        stage('Docker Push') {
            steps {
              script {
                withDockerRegistry(credentialsId: 'docker-cred') {
                  sh 'docker push  yukesh24/boardgame:latest '
                }
              }
            }
        }
    }
}
